rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // scans: หน้าเว็บอ่าน/เพิ่ม/ลบ ตามการใช้งานปัจจุบัน
    match /scans/{document=**} {
      allow read, write: if true;
    }

    // cards (Master Data): หน้าเว็บอ่านอย่างเดียว
    // การอัปโหลดจาก Excel ทำผ่าน Admin SDK (UploadToFirebase.js)
    // ซึ่งข้าม rules อยู่แล้ว จึงไม่ต้องเปิด write ให้หน้าเว็บ
    match /cards/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
